{
  "areaVisibility": true,
  "transitModelTimeZone": "America/Chicago",
  "islandPruning": {
    "islandWithoutStopsMaxSize": 300,
    "islandWithStopsMaxSize": 30
  },
  "osmNaming": "sidewalks",
  "osmDefaults": {
    "osmTagMapping": "twin-cities"
  },
  "transferRequests": [
    {
      "modes": "WALK"
    },
    {
      "modes": "WALK",
      "wheelchairAccessibility": {
        "enabled": true
      }
    }
  ],
  "fares": "gtfs",
  "transfers": {
    "walk": {
    },
    "bicycle": {
    },
    // allow transfers even when the accessiblity is not clearly defined, in the GTFS but at a high cost
    "wheelchair": {
      "stop": { "onlyConsiderAccessible": false, "unknownCost": 600, "inaccessibleCost": 3600 }
    }
  }
}
